# ============================================================
# StockAche backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable / anon key. Safe for the browser. Used server-side only as the
# `apikey` header when introspecting a user's access token.
SUPABASE_ANON_KEY=
# Secret / service_role key. SERVER ONLY. Bypasses Row Level Security.
SUPABASE_SERVICE_KEY=
# Storage bucket that holds stocklot photos.
SUPABASE_STORAGE_BUCKET=stocklot-images

# Optional: if you paste your project's JWT secret here, Django verifies access
# tokens locally (fast) instead of calling Supabase /auth/v1/user (a network hop).
SUPABASE_JWT_SECRET=

# --- Database ---
# Leave DATABASE_URL empty to use local SQLite (the default for local development).
# To point Django at Supabase Postgres, use the *session pooler* connection
# string from Supabase -> Project Settings -> Database:
#   postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Marketplace economics ---
# Platform commission taken on the goods subtotal of each order (0.02 = 2%).
# Transport and express fees are pass-through and are never commissioned.
PLATFORM_COMMISSION_RATE=0.02

# --- Local development conveniences ---
# When True, exposes POST /api/auth/dev-login/ which mints a local session for a
# seeded account without Google. MUST be False outside local development.
ENABLE_DEV_LOGIN=False

# --- Payments ---
# `sandbox` uses the built-in simulator. `live` requires the bKash credentials
# below and a completed BkashProvider implementation.
PAYMENT_MODE=sandbox
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
