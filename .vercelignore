# Keep the upload small and free of local-only artefacts.
# (Vercel already honours .gitignore for git deployments; this covers CLI ones.)

backend/.venv/
backend/db.sqlite3
backend/media/
backend/staticfiles/
**/__pycache__/
*.pyc

frontend/node_modules/
frontend/dist/

# Report and design assets — not part of the running app.
*.drawio
*.pdf
sample documents/
